// RLR · La Vela en vela.capitaltorreon.com — Ricardo López Reyero
// Publica la carpeta sitio/ y el Worker (src/): redirige los dominios alternos, guarda las solicitudes,
// da el acceso por enlace mágico y sirve el tablero de operación y la liga de pedidos. Desplegar: npx wrangler deploy
{
  "name": "la-vela",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./sitio", "binding": "ASSETS", "run_worker_first": true },
  // Las llaves viven en la bóveda de Cloudflare: aquí solo se ligan. Stripe cobra los pedidos del panel del distribuidor.
  "secrets_store_secrets": [
    { "binding": "RESEND_API_KEY", "store_id": "308dac6355cb4d7a8bef6cc8ef7ee035", "secret_name": "RESEND_API_KEY" },
    { "binding": "STRIPE_SECRET_KEY", "store_id": "308dac6355cb4d7a8bef6cc8ef7ee035", "secret_name": "STRIPE_SECRET_KEY" }
  ],
  // «Vivo»: el objeto que mantiene los WebSockets abiertos y avisa al instante de cada cambio (src/vivo.js)
  "durable_objects": { "bindings": [{ "name": "VIVO", "class_name": "Vivo" }] },
  "migrations": [{ "tag": "vivo-1", "new_sqlite_classes": ["Vivo"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "la-vela", "database_id": "9d5c1d4e-ecf0-444c-a139-a15a441d9758" }
  ],
  "routes": [
    { "pattern": "vela.capitaltorreon.com", "custom_domain": true },
    { "pattern": "la-vela.capitaltorreon.com", "custom_domain": true },
    { "pattern": "lavela.capitaltorreon.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
